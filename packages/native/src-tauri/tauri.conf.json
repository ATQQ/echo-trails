{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "记忆的回响",
  "mainBinaryName": "echo-trails",
  "version": "0.8.2",
  "identifier": "com.echo-trails.app",
  "build": {
    "beforeDevCommand": "cd ../app && VITE_BASE_ORIGIN=http://192.168.31.175:1420 VITE_VERSION_URL=https://photo.sugarat.top/version.json TAURI=true bun run dev",
    "devUrl": "http://192.168.31.175:1420",
    "beforeBuildCommand": "bun scripts/before-build.mjs",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "echo-trails",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPCACHE/**",
          "$APPLOCALDATA/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/192x192.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ATQQ/echo-trails/releases/latest/download/latest.json",
        "https://photo.sugarat.top/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxRTUxQkMwNUYzRTJGMkEKUldRcUx6NWZ3QnZsVVYxbkw0ZlJzS2tCZU10NGhhL3lBaEdXeUxkbTJFbi90QjJlSTh0NlNzdGUK"
    }
  }
}
